#!/bin/bash

APP_NAME="myapp"
DEPLOY_DIR="$HOME/paas-server/deploys/$APP_NAME"
PORT=5001

echo "🚀 Push received for $APP_NAME"

mkdir -p "$DEPLOY_DIR"
git --work-tree="$DEPLOY_DIR" --git-dir="$HOME/paas-server/repos/myapp.git" checkout -f master

echo "✅ Code checked out to $DEPLOY_DIR"

echo "🐳  Building Docker image..."
docker build -t "$APP_NAME" "$DEPLOY_DIR"

echo "🔁 Stopping old container (if any)..."
docker stop "$APP_NAME" 2>/dev/null || echo "⚠️ stop failed or no container to stop" 
docker rm "$APP_NAME" 2>/dev/null || echo "⚠️ rm failed or no container to remove" 

echo "▶️ Starting new container on port $PORT..."
docker run -d --name "$APP_NAME" -p "$PORT:5000" "$APP_NAME"


echo "✅ App deployed! Visit: http://localhost:$PORT" 

